# Videl-Api - Multi-Source Media API Configuration
# Sources: YouTube, SoundCloud, Bandcamp, Spotify, Deezer, Apple Music,
#          Vimeo, Dailymotion, TikTok, Facebook, Instagram, X/Twitter,
#          Piped, Invidious, M3U8/HLS, MPEG-DASH + 1000+ additional sites

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Auth ----
API_KEYS=enabled
ADMIN_KEYS=
API_KEY_PREFIX=videl_

# ---- Telegram WebApp / Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=videl_api_bot

# ---- MongoDB (optional, falls back to JSON file) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videl_music

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

# ---- Quotas ----
QUOTA_DAILY_REQUESTS=1000
QUOTA_MONTHLY_REQUESTS=30000
QUOTA_DAILY_BYTES=0
QUOTA_MONTHLY_BYTES=0

# ---- Downloader ----
DOWNLOAD_FORMAT=bestaudio/best
DOWNLOAD_SOCKET_TIMEOUT=20
DOWNLOAD_RETRIES=3
DOWNLOAD_FRAGMENT_RETRIES=3
DOWNLOAD_CLEANUP_SECONDS=900
DOWNLOAD_MAX_FILESIZE_MB=0
DOWNLOAD_DIR=downloads
DOWNLOAD_PROXY=
DOWNLOAD_PROXY_FILE=
DOWNLOAD_COOKIES=
DOWNLOAD_COOKIES_FILE=
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_CHUNK_CONNECTIONS=16

# ---- External downloader (aria2c) ----
ARIA2C_PATH=
ARIA2C_ARGS=-x 16 -s 16 -k 1M
ARIA2C_ENABLED=true
ARIA2C_RPC_URL=http://localhost:6800/jsonrpc
ARIA2C_RPC_SECRET=
ARIA2C_RPC_ENABLED=false

# ---- HLS / DASH downloader ----
HLS_ENABLED=true
HLS_MAX_THREADS=16
HLS_MERGE_METHOD=binary
HLS_DECRYPT=true
HLS_DEFAULT_HEADERS={}
HLS_TIMEOUT=30

# ---- Spotify ----
SPOTIFY_ENABLED=true
SPOTIFY_PATH=spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Metadata & lyrics ----
METADATA_EMBED=true
METADATA_ALBUM_ART=true
LYRICS_PROVIDERS=synced,genius,musixmatch,azlyrics
LYRICS_DEFAULT_PROVIDER=synced
SPONSORBLOCK=true

# ---- CORS ----
CORS_ORIGINS=*

# ---- Search ----
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100

# ---- Security ----
SSRF_GUARD=true
SSRF_ALLOW_PRIVATE=false
CREDENTIAL_REDACTION=true

# ---- FFmpeg ----
FFMPEG_PATH=

# ---- Telegram Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=videl_api_bot
TELEGRAM_BOT_WEBHOOK_URL=
TELEGRAM_BOT_POLLING=false
TELEGRAM_BOT_ADMINS=
TELEGRAM_BOT_OWNER_ID=0

# ---- Telegram Stars / Payments ----
TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_PRO_PRICE=100
TELEGRAM_STARS_CURRENCY=XTR

# ---- User Management ----
USER_REGISTRATION_ENABLED=true
USER_DEFAULT_TIER=free
USER_MAX_KEYS=5
USER_MAX_PLAYLISTS=10
USER_MAX_DOWNLOADS_PER_DAY=100

# ---- Webhooks ----
WEBHOOK_ENABLED=false
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_SECRET_TOKEN=

# ---- Notifications ----
NOTIFICATION_ENABLED=true
NOTIFICATION_MAX_PER_USER=100

# ---- Playlists ----
PLAYLIST_MAX_ITEMS=200
PLAYLIST_ALLOW_PUBLIC=true

# ---- Batch Operations ----
BATCH_MAX_ITEMS=50
BATCH_MAX_CONCURRENT=5

# ---- Analytics ----
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=90


# ---- Advanced Features ----
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_SIZE=10000
SCHEDULER_ENABLED=true
PLUGIN_SYSTEM_ENABLED=true
ADVANCED_DOWNLOAD_ENABLED=true
ADVANCED_DOWNLOAD_MAX_CONCURRENT=3
FEDERATED_SEARCH_ENABLED=true
WEBSOCKET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
QUOTA_DAILY_REQUESTS=1000
QUOTA_MONTHLY_REQUESTS=30000
QUOTA_DAILY_BYTES=0
QUOTA_MONTHLY_BYTES=0

# ---- Maintenance ----
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.
