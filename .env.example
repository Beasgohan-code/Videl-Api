# Videl-Api - Multi-Source Music API Configuration

# Server
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# API Key Authentication
API_KEYS=enabled
# Comma-separated master admin keys (bypass all checks)
ADMIN_KEYS=
# MongoDB (optional - falls back to file-based keys if not set)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videl_music

# Rate limiting (requests per minute per API key)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

# yt-dlp downloader
YT_DLP_FORMAT=bestaudio/best
YT_DLP_SOCKET_TIMEOUT=20
YT_DLP_RETRIES=3
YT_DLP_FRAGMENT_RETRIES=3
DOWNLOAD_CLEANUP_SECONDS=900
DOWNLOAD_MAX_FILESIZE_MB=0
# Proxy for all downloader requests (http/socks4/socks5)
YOUTUBE_PROXY=
YOUTUBE_PROXY_FILE=
# Cookies for age-restricted / region-locked content
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
# Per-source cookie files (JSON map: {"youtube": "/path/to/cookies.txt"})
YOUTUBE_COOKIES_FILES=

# CORS
CORS_ORIGINS=*

# Temp download directory
DOWNLOAD_DIR=downloads
