# Videl-Api - Multi-Source Music & Stream API
# Sources: YouTube, SoundCloud, Bandcamp, Spotify, Deezer, Apple Music,
#          Vimeo, Dailymotion, TikTok, Facebook, Instagram, X/Twitter,
#          Piped, Invidious, M3U8/HLS, MPEG-DASH + 1000+ yt-dlp sites
# Integrates: yt-dlp, aria2c, spotDL, N_m3u8DL, globocom/m3u8, Eldian (credits→Videl)

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Auth ----
API_KEYS=enabled
ADMIN_KEYS=

# ---- MongoDB (optional, falls back to JSON file) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videl_music

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

# ---- yt-dlp downloader ----
YT_DLP_FORMAT=bestaudio/best
YT_DLP_SOCKET_TIMEOUT=20
YT_DLP_RETRIES=3
YT_DLP_FRAGMENT_RETRIES=3
DOWNLOAD_CLEANUP_SECONDS=900
DOWNLOAD_MAX_FILESIZE_MB=0
DOWNLOAD_DIR=downloads
YOUTUBE_PROXY=
YOUTUBE_PROXY_FILE=
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES_FILES={}

# ---- External downloaders (aria2c, ffmpeg, spotdl) ----
ARIA2C_PATH=
ARIA2C_ARGS=-x 16 -s 16 -k 1M
ARIA2C_ENABLED=true
FFMPEG_PATH=
SPOTDL_PATH=spotdl
SPOTDL_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- aria2c JSON-RPC (aria2/aria2) ----
ARIA2C_RPC_URL=http://localhost:6800/jsonrpc
ARIA2C_RPC_SECRET=
ARIA2C_RPC_ENABLED=false

# ---- M3U8 / HLS / DASH (globocom/m3u8 + N_m3u8DL-RE/CLI) ----
M3U8_ENABLED=true
M3U8_MAX_THREADS=16
M3U8_MERGE_METHOD=binary
M3U8_DECRYPT=true
M3U8_DEFAULT_HEADERS={}
M3U8_TIMEOUT=30

# ---- Metadata & lyrics ----
METADATA_EMBED=true
METADATA_ALBUM_ART=true
LYRICS_PROVIDERS=synced,genius,musixmatch,azlyrics
LYRICS_DEFAULT_PROVIDER=synced
SPONSORBLOCK=true

# ---- Download queue ----
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_CHUNK_CONNECTIONS=16

# ---- CORS ----
CORS_ORIGINS=*

# ---- Search ----
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100

# ---- Telegram WebApp / Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=videl_api_bot

# ---- Telegram Bot /getapi command (optional, requires python-telegram-bot) ----
TELEGRAM_BOT_ENABLED=false
