# Videl-Api - Multi-Source Music API Configuration
# Supports: YouTube, SoundCloud, Bandcamp, Spotify, Deezer, Apple Music,
#           Vimeo, Dailymotion, TikTok, Facebook, Instagram, X/Twitter,
#           Piped, Invidious + 1000+ yt-dlp sites

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Auth ----
API_KEYS=enabled
ADMIN_KEYS=

# ---- MongoDB (optional, falls back to JSON file) ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=videl_music

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

# ---- yt-dlp downloader ----
YT_DLP_FORMAT=bestaudio/best
YT_DLP_SOCKET_TIMEOUT=20
YT_DLP_RETRIES=3
YT_DLP_FRAGMENT_RETRIES=3
DOWNLOAD_CLEANUP_SECONDS=900
DOWNLOAD_MAX_FILESIZE_MB=0
DOWNLOAD_DIR=downloads
YOUTUBE_PROXY=
YOUTUBE_PROXY_FILE=
YOUTUBE_COOKIES=
YOUTUBE_COOKIES_FILE=
YOUTUBE_COOKIES_FILES={}

# ---- External downloaders (aria2c, ffmpeg, spotdl) ----
# aria2c gives multipart parallel downloads (much faster). Install: apt install aria2
ARIA2C_PATH=
ARIA2C_ARGS=-x 16 -s 16 -k 1M
ARIA2C_ENABLED=true
# ffmpeg for audio conversion/post-processing. Install: apt install ffmpeg
FFMPEG_PATH=
# spotdl for Spotify metadata + YouTube audio matching. Install: pip install spotdl
SPOTDL_PATH=spotdl
SPOTDL_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---- Metadata & lyrics ----
METADATA_EMBED=true
METADATA_ALBUM_ART=true
LYRICS_PROVIDERS=synced,genius,musixmatch,azlyrics
LYRICS_DEFAULT_PROVIDER=synced
SPONSORBLOCK=true

# ---- Download queue ----
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_CHUNK_CONNECTIONS=16

# ---- CORS ----
CORS_ORIGINS=*

# ---- Search ----
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
