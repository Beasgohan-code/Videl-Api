# Videl-Api Docker Environment Configuration
# Copy this to .env and adjust values before running docker-compose

# ---- Server ----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# ---- Logging ----
VIDEL_LOG_LEVEL=INFO
VIDEL_LOG_FORMAT=json
VIDEL_LOG_DIR=/app/logs
VIDEL_LOG_MAX_BYTES=10485760
VIDEL_LOG_BACKUP_COUNT=5

# ---- Watchdog / Keep-Alive ----
VIDEL_WATCHDOG_CHECK_INTERVAL=30
VIDEL_WATCHDOG_RECOVERY_INTERVAL=60

# ---- Auth ----
API_KEY_PREFIX=videl_
ADMIN_KEYS=

# ---- Telegram WebApp / Bot ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=videl_api_bot
TELEGRAM_BOT_WEBHOOK_URL=

# ---- MongoDB (optional) ----
MONGODB_URI=mongodb://mongodb:27017/videl_music
MONGODB_DB=videl_music

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60

# ---- Quotas ----
QUOTA_DAILY_REQUESTS=1000
QUOTA_MONTHLY_REQUESTS=30000
QUOTA_DAILY_BYTES=0
QUOTA_MONTHLY_BYTES=0

# ---- Downloader ----
DOWNLOAD_DIR=/app/downloads
DOWNLOAD_MAX_CONCURRENT=3
DOWNLOAD_FORMAT=bestaudio/best
DOWNLOAD_CLEANUP_SECONDS=900

# ---- External downloader (aria2c) ----
ARIA2C_ENABLED=true
ARIA2C_RPC_URL=http://aria2c:6800/jsonrpc
ARIA2C_RPC_SECRET=
ARIA2C_RPC_ENABLED=true

# ---- HLS / DASH ----
HLS_ENABLED=true
HLS_MAX_THREADS=16

# ---- Spotify ----
SPOTIFY_ENABLED=true

# ---- Metadata & lyrics ----
METADATA_EMBED=true
SPONSORBLOCK=true

# ---- CORS ----
CORS_ORIGINS=*

# ---- Telegram Stars / Payments ----
TELEGRAM_STARS_ENABLED=true
TELEGRAM_STARS_CURRENCY=XTR

# ---- Maintenance ----
MAINTENANCE_MODE=false
